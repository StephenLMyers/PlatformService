# PlatformService -- example configuration
#
# Copy to config/platform.conf and edit. That file is git-ignored.
# Every setting below is OPTIONAL: the defaults shown are what the service
# uses when no config file is present, so the service runs with no file at all.
#
# Every setting can also be overridden by an environment variable, which takes
# precedence over this file. The variable name is shown beside each setting.
#
# SECRETS ARE NOT CONFIGURABLE HERE. PS_JWT_SECRET and the BOOTSTRAP_ADMIN_*
# values come from the environment only, and the service will REFUSE TO START
# if it finds them in a config file. Config files get committed; a secret in
# git history is permanent.

# ---------------------------------------------------------------- server ----
# Loopback by default so a development build is never accidentally exposed
# to the local network. Set 0.0.0.0 deliberately, not by habit.
server.bind_address        = 127.0.0.1     # PS_BIND_ADDRESS
server.port                = 8443          # PS_PORT
# Dev mode relaxes rate limits, logs verification links, and exposes the dev
# outbox. It never alters authorization, token validation, or password policy.
server.dev_mode            = false         # PS_DEV_MODE
server.worker_threads      = 0             # PS_WORKER_THREADS (0 = one per CPU)
server.accept_queue_depth  = 256           # PS_ACCEPT_QUEUE_DEPTH
server.shutdown_grace_s    = 30            # PS_SHUTDOWN_GRACE_S

# ------------------------------------------------------------------ http ----
http.max_request_line       = 8192         # PS_MAX_REQUEST_LINE
http.max_header_bytes       = 16384        # PS_MAX_HEADER_BYTES
http.max_header_count       = 64           # PS_MAX_HEADER_COUNT
http.max_body_bytes         = 1048576      # PS_MAX_BODY_BYTES
http.read_timeout_s         = 30           # PS_READ_TIMEOUT_S
http.write_timeout_s        = 30           # PS_WRITE_TIMEOUT_S
http.keepalive_idle_s       = 15           # PS_KEEPALIVE_IDLE_S
http.keepalive_max_requests = 100          # PS_KEEPALIVE_MAX_REQUESTS

# ------------------------------------------------------------------ cors ----
# Off by default -- empty means no Access-Control-* headers are ever
# emitted and OPTIONS returns 405 (plan 7.2a). There is no browser client
# for this API; enabling this is a deliberate config change, not something
# to turn on out of habit.
cors.allowed_origins        =               # PS_CORS_ALLOWED_ORIGINS (comma-separated, e.g. https://a.example,https://b.example)
# A literal "*" combined with allow_credentials=true is refused at startup,
# not merely discouraged -- that combination is a cross-origin credential
# leak, and no browser honors it anyway.
cors.allow_credentials      = false        # PS_CORS_ALLOW_CREDENTIALS

# ------------------------------------------------------------------- tls ----
# Generate a development certificate with: make dev-cert
# The private key must be mode 0600 or startup refuses to continue.
tls.enabled                = true          # PS_TLS_ENABLED
tls.cert_path              = ./certs/dev-cert.pem   # PS_TLS_CERT_PATH
tls.key_path               = ./certs/dev-key.pem    # PS_TLS_KEY_PATH

# -------------------------------------------------------------- database ----
db.path                    = ./data/platform.db     # PS_DB_PATH
# Without a busy timeout, two overlapping writers surface as a failed request
# the instant they collide.
db.busy_timeout_ms         = 5000          # PS_DB_BUSY_TIMEOUT_MS

# ------------------------------------------------------------------ auth ----
auth.access_token_ttl_s     = 900          # PS_ACCESS_TOKEN_TTL_S      (15 min)
auth.refresh_idle_ttl_s     = 2592000      # PS_REFRESH_IDLE_TTL_S      (30 days)
auth.refresh_absolute_ttl_s = 7776000      # PS_REFRESH_ABSOLUTE_TTL_S  (90 days)
auth.verification_ttl_s     = 86400        # PS_VERIFICATION_TTL_S      (24 hours)

# PBKDF2-HMAC-SHA256 iterations. Lower this ONLY in test fixtures; it is the
# entire cost of an offline attack against a stolen password hash.
auth.kdf_iterations         = 600000       # PS_KDF_ITERATIONS

# Lockout is temporary and self-clearing. A permanent lock would hand an
# attacker a denial-of-service primitive against any known username.
auth.lockout_threshold      = 10           # PS_LOCKOUT_THRESHOLD
auth.lockout_duration_s     = 900          # PS_LOCKOUT_DURATION_S

# Length over composition, per NIST SP 800-63B. There are no character-class
# rules by design.
auth.password_min_length    = 12           # PS_PASSWORD_MIN_LENGTH
auth.password_max_length    = 128          # PS_PASSWORD_MAX_LENGTH

auth.jwt_issuer             = platformservice        # PS_JWT_ISSUER
auth.jwt_audience           = platformservice-api    # PS_JWT_AUDIENCE
auth.common_passwords_path  = ./data/common-passwords.txt  # PS_COMMON_PASSWORDS_PATH

# ----------------------------------------------------------- maintenance ----
# Sweeps expired tokens, dead session families, and aged audit rows. Deletes
# run in bounded batches so the sweep never holds the write lock long enough
# to stall request handling.
maintenance.interval_s     = 3600          # PS_MAINTENANCE_INTERVAL_S
maintenance.batch_size     = 1000          # PS_MAINTENANCE_BATCH_SIZE
audit.retention_days       = 365           # PS_AUDIT_RETENTION_DAYS

# ------------------------------------------------------------- ratelimit ----
# max_entries bounds the limiter's own memory. An unbounded table keyed by
# source IP turns the defence against denial of service into a memory
# exhaustion vector, so entries are evicted LRU once this cap is reached.
ratelimit.max_entries          = 100000    # PS_RATELIMIT_MAX_ENTRIES
ratelimit.login_per_minute     = 10        # PS_RATELIMIT_LOGIN
ratelimit.register_per_minute  = 5         # PS_RATELIMIT_REGISTER

# Resend limits are enforced per EMAIL ADDRESS, not per IP: the abuse target
# is a third party's inbox, and a distributed caller evades per-IP limits.
ratelimit.resend_min_interval_s = 60       # PS_RESEND_MIN_INTERVAL_S
ratelimit.resend_max_per_day    = 5        # PS_RESEND_MAX_PER_DAY

# ------------------------------------------------------------------- log ----
log.level                  = INFO          # PS_LOG_LEVEL (TRACE|DEBUG|INFO|WARN|ERROR)
